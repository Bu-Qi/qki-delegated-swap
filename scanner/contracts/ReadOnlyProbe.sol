pragma solidity 0.8.24;
interface F {function allPairsLength() external view returns(uint);function allPairs(uint) external view returns(address);function getPair(address,address) external view returns(address);}
interface P {function token0() external view returns(address);function token1() external view returns(address);function getReserves() external view returns(uint112,uint112,uint32);function swap(uint,uint,address,bytes calldata) external;}
interface T {function balanceOf(address) external view returns(uint);function decimals() external view returns(uint8);function symbol() external view returns(string memory);}
interface W {function deposit() external payable;function withdraw(uint) external;}
interface R {function factory() external view returns(address);function getAmountOut(uint,uint,uint) external view returns(uint);function swapExactTokensForTokensSupportingFeeOnTransferTokens(uint,uint,address[] calldata,address,uint) external;}
/// @notice Runtime code is used only inside eth_call state overrides; never deployed by the scanner.
contract ReadOnlyProbe {
 receive() external payable {}
 struct Pool {address pair;address t0;address t1;uint112 r0;uint112 r1;uint b0;uint b1;bool valid;}
 struct Token {address token;string symbol;uint8 decimals;bool precisionKnown;}
 error HopFailed(uint hop,bytes reason);
 error TokenFailed(bytes reason);
 function tokenCall(address token,bytes memory data) private {(bool ok,bytes memory result)=token.call(data);if(!ok)revert TokenFailed(result);require(result.length==0||abi.decode(result,(bool)),"TOKEN_FALSE");}
 function pool(address pair) external view returns(Pool memory row){row.pair=pair;row.t0=P(pair).token0();row.t1=P(pair).token1();(row.r0,row.r1,)=P(pair).getReserves();row.b0=T(row.t0).balanceOf(pair);row.b1=T(row.t1).balanceOf(pair);row.valid=true;}
 function pools(address factory,uint start,uint n) external view returns(Pool[] memory rows){uint count=F(factory).allPairsLength();if(start>=count)return new Pool[](0);if(start+n>count)n=count-start;rows=new Pool[](n);for(uint i;i<n;++i){address p=F(factory).allPairs(start+i);try this.pool(p) returns(Pool memory row){rows[i]=row;}catch{rows[i].pair=p;}}}
 function tokens(address[] calldata ts) external view returns(Token[] memory rows){rows=new Token[](ts.length);for(uint i;i<ts.length;++i){rows[i].token=ts[i];try T(ts[i]).symbol{gas:50000}() returns(string memory s){rows[i].symbol=s;}catch{}try T(ts[i]).decimals{gas:50000}() returns(uint8 d){rows[i].decimals=d;rows[i].precisionKnown=true;}catch{}}}
 function holderCycle(address router,address asset,address holder,address[] calldata path,uint amount) external returns(uint output,uint spent){uint g=gasleft();require(path[0]==asset&&path[path.length-1]==asset,"CYCLE");uint beforeHolder=T(asset).balanceOf(holder);uint beforeSelf=T(asset).balanceOf(address(this));tokenCall(asset,abi.encodeWithSignature("transferFrom(address,address,uint256)",holder,address(this),amount));tokenCall(asset,abi.encodeWithSignature("approve(address,uint256)",router,amount));R(router).swapExactTokensForTokensSupportingFeeOnTransferTokens(amount,1,path,address(this),block.timestamp+3600);output=T(asset).balanceOf(address(this))-beforeSelf;tokenCall(asset,abi.encodeWithSignature("transfer(address,uint256)",holder,output));require(T(asset).balanceOf(holder)+amount==beforeHolder+output,"HOLDER_BALANCE_MISMATCH");spent=g-gasleft();}
 function nativeCycle(address router,address w,address[] calldata path) external payable returns(uint output,uint spent){uint g=gasleft();require(path[0]==w&&path[path.length-1]==w,"CYCLE");uint beforeW=T(w).balanceOf(address(this));uint beforeNative=address(this).balance-msg.value;W(w).deposit{value:msg.value}();tokenCall(w,abi.encodeWithSignature("approve(address,uint256)",router,msg.value));R(router).swapExactTokensForTokensSupportingFeeOnTransferTokens(msg.value,1,path,address(this),block.timestamp+3600);output=T(w).balanceOf(address(this))-beforeW;W(w).withdraw(output);require(address(this).balance-beforeNative==output,"NATIVE_MISMATCH");(bool ok,)=msg.sender.call{value:output}("");require(ok,"NATIVE_RETURN_FAILED");spent=g-gasleft();}
 function diagnose(address router,address asset,address holder,address[] calldata path,uint amount,bool nativeInput) external payable {address[] memory pairs=new address[](path.length-1);for(uint i;i<pairs.length;++i)pairs[i]=F(R(router).factory()).getPair(path[i],path[i+1]);if(nativeInput){require(msg.value==amount,"VALUE");W(asset).deposit{value:amount}();tokenCall(asset,abi.encodeWithSignature("transfer(address,uint256)",pairs[0],amount));}else tokenCall(asset,abi.encodeWithSignature("transferFrom(address,address,uint256)",holder,pairs[0],amount));for(uint i;i<pairs.length;++i){P p=P(pairs[i]);bool input0=p.token0()==path[i];(uint112 r0,uint112 r1,)=p.getReserves();uint rin=input0?r0:r1;uint rout=input0?r1:r0;uint b=T(path[i]).balanceOf(pairs[i]);require(b>rin,"NO_INPUT");uint out=R(router).getAmountOut(b-rin,rin,rout);address recipient=i+1<pairs.length?pairs[i+1]:address(this);try p.swap(input0?0:out,input0?out:0,recipient,""){}catch(bytes memory reason){revert HopFailed(i,reason);}}}
}
